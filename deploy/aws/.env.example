# Copy with: bash deploy/aws/configure.sh app.example.com operator@example.com
# Real credentials are generated locally, never committed or put in user-data.
# For an explicitly selected 1-GB host, pass small as the third configure.sh
# argument and to bootstrap.sh. The script appends all resource overrides;
# changing only AWS_MEMORY_PROFILE here does not change memory limits.
AWS_MEMORY_PROFILE=standard
DOMAIN=app.example.com
ACME_EMAIL=operator@example.com
POSTGRES_PASSWORD=GENERATE_WITH_CONFIGURE_SCRIPT
INTAKE_DB_PASSWORD=GENERATE_WITH_CONFIGURE_SCRIPT
MINIO_ROOT_USER=grimoire-storage-admin
MINIO_ROOT_PASSWORD=GENERATE_WITH_CONFIGURE_SCRIPT
GRIMOIRE_S3_ACCESS_KEY=grimoire-production-api
GRIMOIRE_S3_SECRET_KEY=GENERATE_WITH_CONFIGURE_SCRIPT
GRIMOIRE_S3_BUCKET=grimoire-sources-prod
PGPORT=55432
API_IMAGE=grimoire-api:local
WEB_IMAGE=grimoire-web:local
OPS_IMAGE=grimoire-ops:local
STORAGE_IMAGE=grimoire-storage:local
MC_IMAGE=grimoire-mc:local
# Optional Google sign-in; normal password sign-in works without it.
GRIMOIRE_GOOGLE_CLIENT_ID=
